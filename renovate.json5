{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>jaimemachado/renovate-config",
    "github>jaimemachadoneto/home-ops//.renovate/overrides.json5",
    "github>jaimemachadoneto/home-ops//.renovate/groups.json5",
    "github>jaimemachadoneto/home-ops//.renovate/autoMerge.json5",
    "github>jaimemachadoneto/home-ops//.renovate/customManagers.json5",
    "github>jaimemachadoneto/home-ops//.renovate/grafanaDashboards.json5",
  ],
  flux: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  "helm-values": {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  kubernetes: {
    managerFilePatterns: ["/^kubernetes/.+\\.yaml(?:\\.j2)?$/"],
  },
  packageRules: [
    {
      // A tag can point to a new image at any time. The digest makes each
      // change of the image a PR. Only the container images: the flux
      // manager also reads the OCIRepository charts, and their digests are
      // not decided yet (Work 2 ticket 9d). The Docker hosts follow later.
      description: "Pin the container images of the cluster by digest",
      matchDatasources: ["docker"],
      matchManagers: ["kubernetes", "helm-values"],
      matchFileNames: ["kubernetes/**"],
      pinDigests: true,
    },
    {
      description: "Configure Emby versioning",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/home-operations/emby"],
      versioning: "loose",
    },
  ],
}
