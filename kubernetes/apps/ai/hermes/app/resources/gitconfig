# The GitHub token for git in the Hermes pod. The helper reads the token from the
# environment, so no token is in a file. Only the sandboxes use GITHUB_TOKEN_PERSONAL
# (ADR 0008 of hermes-k8s), so this file has no helper for jaimemachadoneto.
[credential "https://github.com"]
	helper = "!f() { test \"$1\" = get && printf 'username=x-access-token\\npassword=%s\\n' \"$GITHUB_TOKEN\"; }; f"
